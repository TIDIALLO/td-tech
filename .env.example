# ============================================
# SYNAP6IA - Variables d'Environnement
# ============================================
# Copier ce fichier vers .env et remplir les valeurs
# cp .env.example .env

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://synap6ia.com

# ============================================
# BASE DE DONNÉES (PostgreSQL)
# ============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Note: Encoder les caractères spéciaux (! → %21, # → %23, @ → %40)
DATABASE_URL=postgresql://synap6ia_user:PASSWORD@localhost:5432/synap6ia_prod?sslmode=require

# ============================================
# AUTHENTIFICATION (NextAuth.js)
# ============================================
# Générer: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here-minimum-32-characters
AUTH_URL=https://synap6ia.com

# ============================================
# EMAIL - GMAIL SMTP (Recommandé)
# ============================================
USE_GMAIL_SMTP=true
GMAIL_USER=your-email@gmail.com
# Créer un App Password: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your-16-char-app-password

# ============================================
# EMAIL - RESEND (Alternative)
# ============================================
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM_EMAIL=contact@synap6ia.com

# ============================================
# N8N AUTOMATION WEBHOOK
# ============================================
# Production (sans -test)
N8N_WEBHOOK_URL=https://n8n.srv787787.hstgr.cloud/webhook/contact-form

# ============================================
# UPLOADTHING (Optionnel - Upload fichiers)
# ============================================
# UPLOADTHING_TOKEN=
# UPLOADTHING_SECRET=

# ============================================
# ADMIN (Optionnel - Création compte admin)
# ============================================
# ADMIN_EMAIL=admin@synap6ia.com
# ADMIN_PASSWORD=SecurePassword123!
